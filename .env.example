GROQ_API_KEY=gsk_your_key_here
TAVILY_API_KEY=

LLM_MODEL=openai/gpt-oss-120b
LLM_BASE_URL=https://api.groq.com/openai/v1

# Retrieval depth. Defaults in core/config.py are what the README numbers were
# measured at; override only to run an A/B against the same question set.
SUB_QUERIES=8
RESULTS_PER_QUERY=3
WRITER_INPUT_CHARS=12000
WRITER_CONTEXT_CHARS=2500
WRITER_MAX_TOKENS=3500

# Read directly from the environment, not from settings. On by default, with no
# expiry -- set 0 if you want live search results.
CITEMIND_CACHE=1

API_PORT=8000
LOG_LEVEL=info